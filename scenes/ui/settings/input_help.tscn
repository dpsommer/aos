[gd_scene format=3]

[node name="InputHelp" type="HBoxContainer"]
theme_override_constants/separation = 16

[node name="Help" type="Label" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DescriptionLabel"
text = "Select a key to change it, then press the new key. Esc cancels."
autowrap_mode = 3

[node name="ResetAll" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Reset every key to its default"
theme_type_variation = &"GhostButton"
text = "Reset all"
metadata/focus_key = "settings:reset_all"
