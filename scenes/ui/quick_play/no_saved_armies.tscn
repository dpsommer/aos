[gd_scene format=3]

[node name="NoSavedArmies" type="PanelContainer"]
theme_type_variation = &"EmptyPanel"

[node name="Stack" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Stack"]
layout_mode = 2
theme_type_variation = &"CardHeadingLabel"
text = "No saved armies yet"

[node name="Text" type="Label" parent="Stack"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DescriptionLabel"
text = "Build an army in the Forge to bring it to Matched Play."
autowrap_mode = 3

[node name="OpenForge" type="Button" parent="Stack"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_type_variation = &"GoldButton"
text = "Open the Forge"
