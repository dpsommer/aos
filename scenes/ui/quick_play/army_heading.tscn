[gd_scene format=3]

[node name="ArmyHeading" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="TitleRow" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="TitleRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PageTitleLabel"

[node name="Subtitle" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DescriptionLabel"
autowrap_mode = 3

[node name="Points" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
