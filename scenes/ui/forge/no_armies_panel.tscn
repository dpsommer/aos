[gd_scene format=3]

[node name="NoArmiesPanel" type="PanelContainer"]
custom_minimum_size = Vector2(0, 160)
theme_type_variation = &"EmptyPanel"

[node name="Stack" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Title" type="Label" parent="Stack"]
layout_mode = 2
theme_type_variation = &"CardHeadingLabel"
text = "No saved armies yet"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Stack"]
layout_mode = 2
theme_type_variation = &"DescriptionLabel"
text = "Start one with New army."
horizontal_alignment = 1
