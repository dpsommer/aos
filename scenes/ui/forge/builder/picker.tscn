[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/forge/builder/picker.gd" id="1_picker"]
[ext_resource type="Texture2D" path="res://assets/2d/icons/close.svg" id="2_close"]

[node name="Picker" type="VBoxContainer"]
size_flags_vertical = 3
script = ExtResource("1_picker")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
autowrap_mode = 3

[node name="Close" type="Button" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Close without picking"
theme_type_variation = &"IconButton"
icon = ExtResource("2_close")
icon_alignment = 1
accessibility_name = "Close without picking"
metadata/focus_key = "picker:close"

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[connection signal="pressed" from="Header/Close" to="." method="close"]
