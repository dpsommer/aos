[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/forge/builder/renown_card.gd" id="1_card"]

[node name="RenownCard" type="PanelContainer"]
theme_type_variation = &"CardPanel"
script = ExtResource("1_card")

[node name="Content" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleRow" type="HBoxContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="Names" type="VBoxContainer" parent="Content/TitleRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Content/TitleRow/Names"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CardTitleLabel"
autowrap_mode = 3

[node name="Subtitle" type="Label" parent="Content/TitleRow/Names"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"

[node name="Chips" type="HFlowContainer" parent="Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="Text" type="Label" parent="Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="Status" type="Label" parent="Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="AddRow" type="HBoxContainer" parent="Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="Add" type="Button" parent="Content/AddRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"GoldButton"
text = "Add to army"
