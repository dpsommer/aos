[gd_scene format=3]

[node name="TerrainRow" type="PanelContainer"]
theme_type_variation = &"RowPanel"

[node name="Row" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Names" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Row/Names"]
unique_name_in_owner = true
layout_mode = 2
text_overrun_behavior = 3

[node name="Detail" type="Label" parent="Row/Names"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text_overrun_behavior = 3

[node name="Points" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
