[connection signal="pressed" from="Layout/Header/Margin/Row/BackButton" to="." method="request_back"]
[connection signal="pressed" from="Layout/Header/Margin/Row/SaveButton" to="." method="save"]
[connection signal="confirmed" from="DiscardDialog" to="." method="_on_discard_confirmed"]
[connection signal="custom_action" from="DiscardDialog" to="." method="_on_discard_dialog_action"]
