[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/forge/builder/army_builder.gd" id="1_builder"]
[ext_resource type="Texture2D" path="res://assets/2d/icons/delete.svg" id="2_delete"]

[node name="ArmyBuilder" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
