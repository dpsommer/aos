text = "Forge"

[node name="Titles" type="VBoxContainer" parent="Layout/Header/Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="FactionLabel" type="Label" parent="Layout/Header/Margin/Row/Titles"]
