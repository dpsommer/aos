[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

[node name="Header" type="PanelContainer" parent="Layout"]
layout_mode = 2
theme_type_variation = &"HeaderPanel"

[node name="Margin" type="MarginContainer" parent="Layout/Header"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 12

[node name="Row" type="HBoxContainer" parent="Layout/Header/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="BackButton" type="Button" parent="Layout/Header/Margin/Row"]
unique_name_in_owner = true
