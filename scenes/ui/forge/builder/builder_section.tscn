[gd_scene format=3]

[node name="BuilderSection" type="VBoxContainer"]
theme_override_constants/separation = 10

[node name="Heading" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SectionLabel"

[node name="Note" type="Label" parent="Heading"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
