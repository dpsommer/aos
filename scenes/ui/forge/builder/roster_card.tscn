[gd_scene format=3]

[ext_resource type="Texture2D" path="res://assets/2d/icons/star.svg" id="1_star"]

[node name="RosterCard" type="PanelContainer"]
theme_type_variation = &"RowPanel"

[node name="Content" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Top" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CardButton" type="Button" parent="Content/Top"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CardButton"

[node name="Face" type="HBoxContainer" parent="Content/Top/CardButton"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Names" type="VBoxContainer" parent="Content/Top/CardButton/Face"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 3
alignment = 1

[node name="Title" type="Label" parent="Content/Top/CardButton/Face/Names"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardTitleLabel"
text_overrun_behavior = 3

[node name="Details" type="HBoxContainer" parent="Content/Top/CardButton/Face/Names"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Points" type="Label" parent="Content/Top/CardButton/Face/Names/Details"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"

[node name="Star" type="Button" parent="Content/Top"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"IconButton"
toggle_mode = true
icon = ExtResource("1_star")
icon_alignment = 1

[node name="AddRow" type="HBoxContainer" parent="Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="AddAuxiliary" type="Button" parent="Content/AddRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Add as auxiliary unit"
