text = "Add regiment"
metadata/focus_key = "army:add_regiment"

[node name="AddRegimentOfRenown" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"GhostButton"
text = "Add Regiment of Renown"
metadata/focus_key = "army:add_ror"
