[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/common/inline_line.gd" id="1_line"]
[ext_resource type="Texture2D" path="res://assets/2d/icons/rename.svg" id="2_rename"]

[node name="ArmyNameLine" type="Container"]
script = ExtResource("1_line")
separation = 10

[node name="Name" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 1
theme_type_variation = &"PageTitleLabel"
theme_override_font_sizes/font_size = 30
vertical_alignment = 1
text_overrun_behavior = 3

[node name="Rename" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Rename army"
theme_type_variation = &"IconButton"
icon = ExtResource("2_rename")
icon_alignment = 1
accessibility_name = "Rename army"
metadata/focus_key = "army:rename"
