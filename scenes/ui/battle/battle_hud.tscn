[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/battle/battle_hud.gd" id="1_hud"]
[ext_resource type="Texture2D" path="res://assets/2d/icons/settings.svg" id="2_settings"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_header"]
bg_color = Color(0.047, 0.051, 0.063, 0.85)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_badge"]
content_margin_left = 10.0
content_margin_top = 4.0
content_margin_right = 10.0
content_margin_bottom = 4.0
bg_color = Color(0.1647, 0.1843, 0.2196, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_player"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
bg_color = Color(0.141, 0.322, 0.494, 0.45)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.2392, 0.4549, 0.6588, 1)
corner_radius_top_left = 999
corner_radius_top_right = 999
corner_radius_bottom_right = 999
corner_radius_bottom_left = 999

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_opponent"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
bg_color = Color(0.549, 0.165, 0.141, 0.35)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.549, 0.1647, 0.1412, 1)
corner_radius_top_left = 999
corner_radius_top_right = 999
corner_radius_bottom_right = 999
corner_radius_bottom_left = 999

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_controls"]
content_margin_left = 12.0
content_margin_top = 12.0
content_margin_right = 12.0
content_margin_bottom = 12.0
bg_color = Color(0.09, 0.102, 0.122, 0.9)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.1686, 0.1882, 0.2235, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="BattleHud" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_hud")

[node name="Header" type="PanelContainer" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_header")

[node name="Margin" type="MarginContainer" parent="Header"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_right = 20

[node name="Row" type="HBoxContainer" parent="Header/Margin"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="PhaseBadge" type="PanelContainer" parent="Header/Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_styles/panel = SubResource("StyleBoxFlat_badge")

[node name="Phase" type="Label" parent="Header/Margin/Row/PhaseBadge"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7882, 0.8, 0.8275, 1)
theme_override_font_sizes/font_size = 12
text = "PRE-BATTLE"

[node name="Steps" type="HBoxContainer" parent="Header/Margin/Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="Spacer" type="Control" parent="Header/Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="Header/Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"

[node name="PlayerPill" type="PanelContainer" parent="Header/Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_styles/panel = SubResource("StyleBoxFlat_player")

[node name="Row" type="HBoxContainer" parent="Header/Margin/Row/PlayerPill"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Dot" type="ColorRect" parent="Header/Margin/Row/PlayerPill/Row"]
custom_minimum_size = Vector2(8, 8)
layout_mode = 2
size_flags_vertical = 4
color = Color(0.498, 0.698, 0.9098, 1)

[node name="PlayerLabel" type="Label" parent="Header/Margin/Row/PlayerPill/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7804, 0.8706, 0.9804, 1)
theme_override_font_sizes/font_size = 13

[node name="OpponentPill" type="PanelContainer" parent="Header/Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_styles/panel = SubResource("StyleBoxFlat_opponent")

[node name="Row" type="HBoxContainer" parent="Header/Margin/Row/OpponentPill"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Dot" type="ColorRect" parent="Header/Margin/Row/OpponentPill/Row"]
custom_minimum_size = Vector2(8, 8)
layout_mode = 2
size_flags_vertical = 4
color = Color(0.898, 0.5412, 0.502, 1)

[node name="OpponentLabel" type="Label" parent="Header/Margin/Row/OpponentPill/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.7843, 0.7098, 1)
theme_override_font_sizes/font_size = 13

[node name="Menu" type="Button" parent="Header/Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"IconButton"
icon = ExtResource("2_settings")
icon_alignment = 1
metadata/focus_key = "menu"

[node name="Controls" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = -20.0
offset_right = 20.0
offset_bottom = -20.0
grow_vertical = 0
theme_override_styles/panel = SubResource("StyleBoxFlat_controls")

[node name="Lines" type="VBoxContainer" parent="Controls"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="Move" type="Label" parent="Controls/Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"

[node name="Rotate" type="Label" parent="Controls/Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"

[node name="Zoom" type="Label" parent="Controls/Lines"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Wheel  zoom"

[connection signal="pressed" from="Header/Margin/Row/Menu" to="." method="_on_menu_pressed"]
