[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/battle/role_button.gd" id="1_role"]

[node name="RoleButton" type="Button"]
custom_minimum_size = Vector2(400, 104)
theme_type_variation = &"OptionCard"
script = ExtResource("1_role")

[node name="Margin" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 14

[node name="Row" type="HBoxContainer" parent="Margin"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="Words" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Name" type="Label" parent="Margin/Row/Words"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardTitleLabel"

[node name="Text" type="Label" parent="Margin/Row/Words"]
unique_name_in_owner = true
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DescriptionLabel"
autowrap_mode = 3

[connection signal="minimum_size_changed" from="Margin" to="." method="_fit_content"]
