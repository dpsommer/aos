[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/battle/victory_panel.gd" id="1_panel"]

[node name="VictoryPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_panel")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.047, 0.051, 0.063, 0.72)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="Outcome" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DisplayTitleLabel"
horizontal_alignment = 1

[node name="Kind" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DescriptionLabel"
horizontal_alignment = 1

[node name="Score" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SectionLabel"
horizontal_alignment = 1

[node name="Leave" type="Button" parent="Center/Column"]
layout_mode = 2
size_flags_horizontal = 4
theme_type_variation = &"GoldButton"
text = "Return to the main menu"

[connection signal="pressed" from="Center/Column/Leave" to="." method="_on_leave_pressed"]
