[gd_scene format=3]

[node name="StatBox" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"StatPanel"

[node name="Stack" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Value" type="Label" parent="Stack"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatValueLabel"
horizontal_alignment = 1

[node name="Name" type="Label" parent="Stack"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatNameLabel"
horizontal_alignment = 1
