[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/cards/ability_card.gd" id="1_card"]

[node name="AbilityCard" type="PanelContainer"]
script = ExtResource("1_card")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="HeaderMargin" type="MarginContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/margin_left = 2
theme_override_constants/margin_top = 2
theme_override_constants/margin_right = 2
theme_override_constants/margin_bottom = 2

[node name="Header" type="HBoxContainer" parent="Layout/HeaderMargin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="IconBadge" type="PanelContainer" parent="Layout/HeaderMargin/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4

[node name="Icon" type="TextureRect" parent="Layout/HeaderMargin/Header/IconBadge"]
unique_name_in_owner = true
custom_minimum_size = Vector2(16, 16)
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="Timing" type="Label" parent="Layout/HeaderMargin/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"AbilityTimingLabel"
autowrap_mode = 3

[node name="InnerBox" type="PanelContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2

[node name="Inner" type="VBoxContainer" parent="Layout/InnerBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="NameRow" type="HBoxContainer" parent="Layout/InnerBox/Inner"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Name" type="Label" parent="Layout/InnerBox/Inner/NameRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"AbilityNameLabel"
autowrap_mode = 3

[node name="Separator" type="HSeparator" parent="Layout/InnerBox/Inner"]
unique_name_in_owner = true
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="Layout/InnerBox/Inner"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true

[node name="Keywords" type="Label" parent="Layout/InnerBox/Inner"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"KeywordsLabel"
autowrap_mode = 3

[node name="Source" type="Label" parent="Layout/InnerBox/Inner"]
unique_name_in_owner = true
