[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/cards/warscroll_card.gd" id="1_card"]

[node name="WarscrollCard" type="PanelContainer"]
theme_type_variation = &"WarscrollPanel"
script = ExtResource("1_card")

[node name="Content" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Names" type="VBoxContainer" parent="Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2
alignment = 1

[node name="Name" type="Label" parent="Content/Header/Names"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"WarscrollNameLabel"
autowrap_mode = 3

[node name="Subtitle" type="HBoxContainer" parent="Content/Header/Names"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="Details" type="Label" parent="Content/Header/Names/Subtitle"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="Characteristics" type="HBoxContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6
