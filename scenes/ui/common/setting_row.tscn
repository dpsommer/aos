[gd_scene format=3]

[node name="SettingRow" type="PanelContainer"]
theme_type_variation = &"RowPanel"

[node name="Box" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardTitleLabel"

[node name="Note" type="Label" parent="Box"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
autowrap_mode = 3
