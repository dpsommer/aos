[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/common/option_card.gd" id="1_card"]

[node name="OptionCard" type="Button"]
theme_type_variation = &"OptionCard"
script = ExtResource("1_card")

[node name="Content" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 20.0
offset_right = -20.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 12

[connection signal="minimum_size_changed" from="Content" to="." method="_fit_content"]
