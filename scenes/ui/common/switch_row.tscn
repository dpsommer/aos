[gd_scene format=3]

[node name="SwitchRow" type="PanelContainer"]
theme_type_variation = &"RowPanel"

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Text" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardTitleLabel"

[node name="Description" type="Label" parent="Row/Text"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="Switch" type="CheckButton" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
