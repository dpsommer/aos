# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# 3D models and their textures are stored in Git LFS (see docs/technical/models.md).
assets/3d/models/**/*.obj filter=lfs diff=lfs merge=lfs -text
assets/3d/models/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/3d/models/**/*.png filter=lfs diff=lfs merge=lfs -text
